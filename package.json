{
  "name": "smoothkit",
  "version": "1.0.0",
  "description": "Dead-simple React hooks for smooth animations. Bridge the gap between basic CSS transitions and full animation libraries.",
  "author": {
    "name": "Garvit",
    "url": "https://github.com/Garvit1000"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "hooks",
    "animation",
    "smooth",
    "scroll",
    "transition",
    "typescript",
    "react-hooks",
    "reveal",
    "typing-effect",
    "counter",
    "easing"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/Garvit1000/SmoothKit.git"
  },
  "bugs": {
    "url": "https://github.com/Garvit1000/SmoothKit/issues"
  },
  "homepage": "https://github.com/Garvit1000/SmoothKit#readme",
  "scripts": {
    "dev": "next dev",
    "build:package": "tsup && tsc --project tsconfig.build.json --emitDeclarationOnly",
    "build:site": "next build",
    "build": "npm run build:package",
    "start": "next start",
    "lint": "eslint",
    "prepublishOnly": "npm run build:package"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "lucide-react": "^0.562.0",
    "motion": "^12.26.1",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shiki": "^3.21.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "typescript": "^5"
  }
}